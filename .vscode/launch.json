{
  // Run and Debug panel (play button with a bug): pick one of these and press F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Build app and open in browser",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "args": ["--serve"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Publish to my phone (test, build, push to GitHub)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "args": ["--publish"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Build app, open on phone (same Wi-Fi)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "args": ["--serve", "--lan"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
